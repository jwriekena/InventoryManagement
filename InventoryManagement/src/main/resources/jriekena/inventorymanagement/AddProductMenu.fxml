<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="620.0" prefWidth="880.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="jriekena.inventorymanagement.Controller.AddProductMenuController">
    <children>
        <HBox alignment="CENTER_RIGHT" layoutY="534.0" prefHeight="87.0" prefWidth="880.0" spacing="10.0">
            <children>
                <Button fx:id="saveButton" mnemonicParsing="false" onAction="#onClickSaveProduct" text="Save" />
                <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#onClickCancel" text="Cancel" />
            </children>
            <padding>
                <Insets right="60.0" />
            </padding>
        </HBox>
        <VBox prefHeight="500.0" prefWidth="440.0">
            <children>
                <VBox alignment="CENTER" prefHeight="112.0" prefWidth="440.0">
                    <children>
                        <Label alignment="CENTER" text="Add Product">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                    </children>
                    <padding>
                        <Insets left="40.0" />
                    </padding>
                </VBox>
                <VBox alignment="CENTER" prefHeight="452.0" prefWidth="440.0">
                    <children>
                        <GridPane fx:id="productNameTxt" prefHeight="273.0" prefWidth="445.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="215.0" minWidth="10.0" prefWidth="61.0" />
                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="387.0" minWidth="10.0" prefWidth="379.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Label text="    Name" GridPane.rowIndex="1" />
                                <Label text="    ID" />
                                <Label text="    Inv" GridPane.rowIndex="2" />
                                <Label text="    Price" GridPane.rowIndex="3" />
                                <Label text="    Max" GridPane.rowIndex="4" />
                                <TextField fx:id="nameTxt" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="25.0" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                <TextField fx:id="currentInventoryTxt" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="25.0" prefWidth="144.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                <TextField fx:id="productPriceTxt" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="25.0" prefWidth="144.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                <TextField fx:id="productIDTxt" disable="true" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="25.0" prefWidth="200.0" promptText="Auto-Generated" GridPane.columnIndex="1">
                                    <font>
                                        <Font name="System Italic" size="12.0" />
                                    </font></TextField>
                                <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="20.0" GridPane.columnIndex="1" GridPane.rowIndex="4">
                                    <children>
                                        <TextField fx:id="inventoryMaxTxt" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="25.0" prefWidth="144.0" />
                                        <Label text="    Min" />
                                        <TextField fx:id="inventoryMinTxt" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="25.0" prefWidth="144.0" />
                                    </children>
                                </HBox>
                            </children>
                        </GridPane>
                    </children>
                </VBox>
            </children>
        </VBox>
        <VBox alignment="CENTER_RIGHT" layoutX="440.0" prefHeight="540.0" prefWidth="440.0" spacing="10.0">
            <children>
                <TextField fx:id="productPartSearchTxt" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="25.0" prefWidth="212.0" promptText="Search by Part ID or Name">
                    <font>
                        <Font name="System Italic" size="12.0" />
                    </font>
                </TextField>
            <Button fx:id="searchPartButton" mnemonicParsing="false" onAction="#OnClickSearchParts" text="Search" />
                <TableView fx:id="availablePartsTableView" prefHeight="200.0" prefWidth="200.0">
                    <columns>
                        <TableColumn fx:id="partIDColumn" prefWidth="75.0" text="Part ID" />
                        <TableColumn fx:id="partNameColumn" prefWidth="116.0" text="Part Name" />
                        <TableColumn fx:id="partInventoryLevelColumn" prefWidth="115.0" text="Current Inventory" />
                        <TableColumn fx:id="partCostColumn" prefWidth="94.0" text="Price per Unit" />
                    </columns>
                </TableView>
                <Button fx:id="addProductButton" mnemonicParsing="false" onAction="#onClickAddSelectedPartToProduct" text="Add" />
                <TableView fx:id="associatedPartsTableView" prefHeight="200.0" prefWidth="200.0">
                    <columns>
                        <TableColumn fx:id="assocPartIDColumn" prefWidth="75.0" text="Part ID" />
                        <TableColumn fx:id="assocPartNameColumn" prefWidth="116.0" text="Part Name" />
                        <TableColumn fx:id="assocPartInventoryLevelColumn" prefWidth="115.0" text="Current Inventory" />
                        <TableColumn fx:id="assocPartCostColumn" prefWidth="94.0" text="Price per Unit" />
                    </columns>
                </TableView>
                <Button fx:id="removeAssociatedPartButton" mnemonicParsing="false" onAction="#onClickRemovePartFromProduct" text="Remove Associated Part" />
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>
