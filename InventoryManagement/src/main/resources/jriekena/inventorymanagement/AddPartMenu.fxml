<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="576.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="jriekena.inventorymanagement.Controller.AddPartMenuController">
    <children>
        <VBox prefHeight="620.0" prefWidth="600.0">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="600.0">
                    <children>
                        <Label prefHeight="17.0" prefWidth="78.0" text="Add Part">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <RadioButton fx:id="inhouseRadioButton" mnemonicParsing="false" prefHeight="17.0" prefWidth="126.0" selected="true" text="In-House">
                            <font>
                                <Font size="14.0" />
                            </font>
                            <toggleGroup>
                                <ToggleGroup fx:id="inhouseOroutsourcedTG" />
                            </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="outsourcedRadioButton" mnemonicParsing="false" prefHeight="17.0" prefWidth="161.0" text="Outsourced" toggleGroup="$inhouseOroutsourcedTG">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </RadioButton>
                    </children>
                    <padding>
                        <Insets left="30.0" />
                    </padding>
                </HBox>
                <HBox alignment="CENTER" prefHeight="343.0" prefWidth="600.0">
                    <children>
                        <GridPane alignment="CENTER" prefHeight="342.0" prefWidth="512.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="166.0" minWidth="10.0" prefWidth="103.0" />
                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="259.0" minWidth="10.0" prefWidth="149.0" />
                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="201.0" minWidth="10.0" prefWidth="106.0" />
                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="201.0" minWidth="10.0" prefWidth="154.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Label text="ID" />
                                <Label text="Name" GridPane.rowIndex="1" />
                                <Label text="Current Inventory" GridPane.rowIndex="2" />
                                <Label text="Price/Unit" GridPane.rowIndex="3" />
                                <Label text="Max Inventory" GridPane.rowIndex="4" />
                                <Label fx:id="machineIDorCompanyNameLbl" GridPane.rowIndex="5" />
                                <TextField fx:id="partIDTxt" disable="true" editable="false" promptText="Auto-Generated" GridPane.columnIndex="1">
                           <font>
                              <Font name="System Italic" size="12.0" />
                           </font></TextField>
                                <TextField fx:id="partNameTxt" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                <TextField fx:id="currentInventoryTxt" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                <TextField fx:id="pricePerUnitTxt" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                <TextField fx:id="maxInventoryTxt" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                <TextField fx:id="minInventoryTxt" GridPane.columnIndex="3" GridPane.rowIndex="4" />
                                <TextField fx:id="machineIDorCompanyNameTxt" prefHeight="25.0" prefWidth="168.0" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                                <Label text="    Min Inventory" GridPane.columnIndex="2" GridPane.rowIndex="4" />
                        <Label fx:id="machineOrCompanyLabel" GridPane.rowIndex="5" />
                            </children>
                        </GridPane>
                    </children>
                </HBox>
                <HBox alignment="CENTER_RIGHT" prefHeight="181.0" prefWidth="600.0" spacing="10.0">
                    <children>
                        <Button fx:id="saveButton" mnemonicParsing="false" onAction="#onClickSave" text="Save" />
                        <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#onClickCancel" text="Cancel" />
                    </children>
                    <padding>
                        <Insets right="50.0" />
                    </padding>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
